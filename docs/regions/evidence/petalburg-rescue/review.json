  "translations": [
    {
      "label": "PetalburgCity_Text_AreYouATrainer",
      "original": "Excuse me!\n\nLet me guess, from the way you're\ndressed, are you a POKéMON TRAINER?",
      "zh": "",
      "reviewed": false
    },
    {
      "label": "PetalburgCity_Text_ImLookingForTalentedTrainers",
      "original": "I'm roaming the land in search of\ntalented TRAINERS.\n\nI'm sorry to have taken your time.",
      "zh": "",
      "reviewed": false
    },
    {
      "label": "PetalburgCity_Text_WellMaybeNot",
      "original": "… … … … … …\n\nWell, maybe not.\nYour clothes aren't all that dirty.\n\nYou're either a rookie TRAINER,\nor maybe you're just an ordinary kid.",
      "zh": "",
      "reviewed": false
    },
    {
      "label": "PetalburgWoods_Text_HandOverThosePapers",
      "original": "You! DEVON RESEARCHER!\n\nHand over those papers!",
      "zh": "",
      "reviewed": false
    },
    {
      "label": "PetalburgWoods_Text_HaveYouSeenShroomish",
      "original": "Hello, have you seen any POKéMON\ncalled SHROOMISH around here?\n\nI really love that POKéMON.",
      "zh": "",
      "reviewed": false
    },
    {
      "label": "PetalburgWoods_Text_ICantBeWastingTime",
      "original": "Uh-oh! It's a crisis!\nI can't be wasting time!",
      "zh": "",
      "reviewed": false
    },
    {
      "label": "PetalburgWoods_Text_IWasGoingToAmbushYou",
      "original": "I was going to ambush you, but you\nhad to dawdle in PETALBURG WOODS\nforever, didn't you?\n\nI got sick of waiting, so here I am!",
      "zh": "",
      "reviewed": false
    },
    {
      "label": "PetalburgWoods_Text_NoOneCrossesTeamAqua",
      "original": "Hunh? What do you think you're doing?\nWhat, you're going to protect him?\n\nNo one who crosses TEAM AQUA\ngets any mercy, not even a kid!\n\nCome on and battle me!",
      "zh": "",
      "reviewed": false
    },
    {
      "label": "PetalburgWoods_Text_NotAOneToBeFound",
      "original": "Hmmm…\nNot a one to be found…",
      "zh": "",
      "reviewed": false
    },
    {
      "label": "PetalburgWoods_Text_TeamAquaAfterSomethingInRustboro",
      "original": "Didn't that TEAM AQUA thug say\nthey were after something in\nRUSTBORO, too?",
      "zh": "",
      "reviewed": false
    },
    {
      "label": "PetalburgWoods_Text_ThatWasAwfullyClose",
      "original": "Whew…\nThat was awfully close!\n\nThanks to you, he didn't rob me of\nthese important papers.\n\nI know, I'll give you a GREAT BALL as\nmy thanks!",
      "zh": "",
      "reviewed": false
    },
    {
      "label": "PetalburgWoods_Text_YouHaveToHelpMe",
      "original": "Aiyeeeh!\n\nYou're a POKéMON TRAINER, aren't you?\nYou've got to help me, please!",
      "zh": "",
      "reviewed": false
    },
    {
      "label": "PetalburgWoods_Text_YoureKiddingMe",
      "original": "You're kidding me! You're tough!",
      "zh": "",
      "reviewed": false
    },
    {
      "label": "PetalburgWoods_Text_YoureLoadedWithItems",
      "original": "You're loaded with items.\nI can't give you this GREAT BALL.",
      "zh": "",
      "reviewed": false
    },
    {
      "label": "PetalburgWoods_Text_YouveGotSomeNerve",
      "original": "Grrr… You've got some nerve\nmeddling with TEAM AQUA!\nCome on and battle me again!\n\nI wish I could say that, but I'm out of\nPOKéMON…\n\nAnd, hey, we of TEAM AQUA are also\nafter something in RUSTBORO.\n\nI'll let you go today!",
      "zh": "",
      "reviewed": false
    }
  ],
