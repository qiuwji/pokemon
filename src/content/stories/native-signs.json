    "rustborocity.cuttershousesign": {
      "name": "告示牌",
      "lines": [
        "居合斩大师的家"
      ]
    },
    "rustborocity-devoncorp-1f.productsdisplay": {
      "name": "告示牌",
      "lines": [
        "玻璃柜里摆满了原型和试验产品，旁边有说明牌。",
        "除了工业产品，得文现在也销售日用品和药品，让生活更加便利。最近还开始销售训练家工具，包括精灵球和宝可领航员系统。"
      ]
    },
    "rustborocity-devoncorp-1f.rocksmetaldisplay": {
      "name": "告示牌",
      "lines": [
        "玻璃柜里展示着岩石与金属的样本，旁边有一块说明牌。",
        "得文制造股份有限公司最初开采石料，也从砂中的铁屑提炼铁。从这家朴素的原料生产商起步，得文逐渐发展为生产各类工业产品的制造商。"
      ]
    },
    "rustborocity-devoncorp-3f.rarerocksdisplay": {
      "name": "告示牌",
      "lines": [
        "这是社长收集的稀有岩石和石头。"
      ]
    },
    "rustborocity-pokemonschool.studentnotebook": {
      "name": "告示牌",
      "lines": [
        "这是学生的笔记本……",
        "使用精灵球捕捉宝可梦。训练家可以带着最多六只宝可梦。训练家会捕捉、培养宝可梦，并与它们一起对战。训练家的使命，是打败在道馆里等待挑战者的强大训练家。"
      ]
    },
    "slateportcity.nameratershousesign": {
      "name": "告示牌",
      "lines": [
        "姓名鉴定师的家",
        "鉴定宝可梦的昵称。"
      ]
    },
    "slateportcity.marketsign": {
      "name": "告示牌",
      "lines": [
        "凯那集市",
        "出售别处找不到的独特商品！"
      ]
    },
    "slateportcity.oceanicmuseumsign": {
      "name": "告示牌",
      "lines": [
        "无边的大海孕育着所有生命。",
        "海洋科学博物馆"
      ]
    },
    "slateportcity.citysign": {
      "name": "告示牌",
      "lines": [
        "凯那市",
        "人们与宝可梦相遇的港口。"
      ]
    },
    "slateportcity.pokemonfanclubsign": {
      "name": "告示牌",
      "lines": [
        "宝可梦同好会",
        "欢迎所有宝可梦爱好者！"
      ]
    },
    "slateportcity.battletentsign": {
      "name": "告示牌",
      "lines": [
        "对战帐篷凯那会场",
        "找到吧！最棒的宝可梦！"
      ]
    },
    "slateportcity-oceanicmuseum-1f.whirlpoolexperiment": {
      "name": "告示牌",
      "lines": [
        "玻璃容器里的蓝色液体正在旋转。",
        "这是一项利用风人工制造漩涡的实验。"
      ]
    },
    "slateportcity-oceanicmuseum-1f.waterfallexperiment": {
      "name": "告示牌",
      "lines": [
        "玻璃容器里的红色球上下浮动。",
        "这是一项利用小球浮力模拟瀑布的实验。"
      ]
    },
    "slateportcity-oceanicmuseum-1f.oceansoildisplay": {
      "name": "告示牌",
      "lines": [
        "这是海底土壤的样本。",
        "长年累月，生物的遗骸沉到海底，形成沉积层。分析这些地层，就能了解远古的过去。"
      ]
    },
    "slateportcity-oceanicmuseum-1f.beachsanddisplay": {
      "name": "告示牌",
      "lines": [
        "这是海滩沙子的样本。",
        "山上的石头被河流冲下来，不断碰撞、磨碎，变成颗粒，最后成为海滩上的沙子。"
      ]
    },
    "slateportcity-oceanicmuseum-1f.oceanicminifact1": {
      "name": "告示牌",
      "lines": [
        "海洋小知识一：海水为什么是蓝色的？",
        "光由多种颜色组成。光穿过水时，大多数颜色会逐渐消失，但蓝色会保留下来，所以大海看起来是蓝色的。"
      ]
    },
    "slateportcity-oceanicmuseum-1f.oceanicminifact2": {
      "name": "告示牌",
      "lines": [
        "海洋小知识二：海水为什么是咸的？",
        "海水中溶解着钠离子和氯离子等盐分。它们从岩石中溶出，由雨水带进大海。溶解盐分的浓度，让海水变咸。"
      ]
    },
    "slateportcity-oceanicmuseum-1f.oceanicminifact3": {
      "name": "告示牌",
      "lines": [
        "海洋小知识三：大海和陆地哪个更大？",
        "大海覆盖了地球大约百分之七十的面积，其余是陆地。因此，大海的面积是陆地的两倍多。"
      ]
    },
    "slateportcity-oceanicmuseum-1f.fossildisplay": {
      "name": "告示牌",
      "lines": [
        "这是一块带着波浪状纹路的化石。",
        "潮汐冲刷海底的土壤，流动的海水留下细小的凸起和凹槽。这种土壤变成化石后，就叫作波痕。"
      ]
    },
    "slateportcity-oceanicmuseum-1f.depthmeasuringmachine": {
      "name": "告示牌",
      "lines": [
        "一个奇怪的机器正在玻璃罩下旋转。也许是用来测量某种东西深度的……"
      ]
    },
    "slateportcity-oceanicmuseum-2f.waterqualitysample1": {
      "name": "告示牌",
      "lines": [
        "标签上写着：水质样本一。",
        "大海相互连通，但不同地区的水似乎并不一样。"
      ]
    },
    "slateportcity-oceanicmuseum-2f.waterqualitysample2": {
      "name": "告示牌",
      "lines": [
        "标签上写着：水质样本二。",
        "海水的咸度也会因地区而不同吗？"
      ]
    },
    "slateportcity-oceanicmuseum-2f.submersiblereplica": {
      "name": "告示牌",
      "lines": [
        "海底探测舱",
        "用于探索海底的小型无人探测舱的模型。"
      ]
    },
    "slateportcity-oceanicmuseum-2f.submarinereplica": {
      "name": "告示牌",
      "lines": [
        "潜水艇探险一号",
        "高性能海底探测潜水艇的模型。"
      ]
    },
    "slateportcity-oceanicmuseum-2f.sstidalreplica": {
      "name": "告示牌",
      "lines": [
        "渡轮水静号",
        "库斯诺吉造船厂正在建造的船舶的缩小模型。"
      ]
    },
    "slateportcity-oceanicmuseum-2f.ssannereplica": {
      "name": "告示牌",
      "lines": [
        "圣安奴号",
        "环游世界的豪华客轮的模型。"
      ]
    },
    "slateportcity-oceanicmuseum-2f.surfaceseawaterdisplay": {
      "name": "告示牌",
      "lines": [
        "这是介绍海水流动的展板。",
        "海面附近，海水受风推动，以洋流的形式流动。"
      ]
    },
    "slateportcity-oceanicmuseum-2f.deepseawaterdisplay": {
      "name": "告示牌",
      "lines": [
        "这是介绍海水流动的展板。",
        "海底附近，水因温度、盐度等因素的不同而流动。"
      ]
    },
    "slateportcity-oceanicmuseum-2f.hoennmodel": {
      "name": "告示牌",
      "lines": [
        "丰缘地区模型",
        "这是丰缘地区的缩小立体模型。未白镇在哪里呢？"
      ]
    },
    "slateportcity-oceanicmuseum-2f.pressureexperiment": {
      "name": "告示牌",
      "lines": [
        "一个橡胶球正在膨胀、收缩。",
        "在海里，水本身的重量会产生压力。浅水处的压力不算大，但到了极深的海底，小小的一片面积可能承受数万吨的压力。"
      ]
    }
  },
