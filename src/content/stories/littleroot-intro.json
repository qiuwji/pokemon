  "entries": {
    "truck.arrival.male": {
      "trigger": "mapEnter",
      "priority": 30,
      "selector": {
        "map": "LittlerootTown"
      },
      "script": "truck.arrival.male",
      "requires": {
        "all": [
          {
            "not": {
              "flag": "introDone",
              "equals": true
            }
          },
          {
            "compare": {
              "query": {
                "id": "playerGender"
              },
              "op": "eq",
