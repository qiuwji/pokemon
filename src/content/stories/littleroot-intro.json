      "objectId": "littleroot.mom",
      "requires": {
        "all": [
          {
            "compare": {
              "query": {
                "id": "playerGender"
              },
              "op": "eq",
              "value": "female"
            }
          },
          {
            "any": [
              {
                "all": [
                  {
                    "not": {
                      "flag": "introDone"
                    }
                  },
                  {
                    "flag": "momOutside"
                  }
                ]
              },
              {
                "all": [
                  {
                    "flag": "pokedex"
                  },
                  {
                    "not": {
                      "flag": "runningShoes"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "changes": {
        "x": 14,
        "y": 8,
        "dir": "up"
      }
    }
