{
  "id": "emerald:inside-of-truck",
  "version": 1,
  "dialogues": {
    "box.logo": {
      "name": "搬家纸箱",
      "lines": [
        "纸箱上印着宝可梦的标志。",
        "是宝可梦品牌的搬家搬运服务呢。"
      ],
      "mode": "instant"
    }
  },
  "scripts": {
    "box.read": {
      "commands": [
        {
          "type": "dialog",
          "dialogue": "box.logo"
        }
      ]
    },
    "truck.arrival": {
      "commands": [
        {
          "type": "if",
          "condition": {
            "not": {
              "flag": "playerConfigured",
              "equals": true
            }
          },
          "then": [
            {
              "type": "choice",
              "name": "冒险开始",
              "prompt": "选择你的角色。",
              "options": [
                {
                  "id": "male",
                  "label": "小悠",
                  "commands": [
                    {
                      "type": "identity",
                      "gender": "male",
                      "name": "小悠"
                    }
                  ]
                },
                {
                  "id": "female",
                  "label": "小遥",
                  "commands": [
                    {
                      "type": "identity",
                      "gender": "female",
                      "name": "小遥"
                    }
                  ]
                }
              ]
            }
          ],
          "else": []
        },
        {
          "type": "worldPatch",
          "operations": [
            {
              "kind": "tile",
              "map": "InsideOfTruck",
              "x": 4,
              "y": 1,
              "appearance": 525,
              "scope": "permanent"
            },
            {
              "kind": "tile",
              "map": "InsideOfTruck",
              "x": 4,
              "y": 2,
              "appearance": 533,
              "scope": "permanent"
            },
            {
              "kind": "tile",
              "map": "InsideOfTruck",
              "x": 4,
              "y": 3,
              "appearance": 541,
              "scope": "permanent"
            }
          ]
        },
        {
          "type": "parallel",
          "commands": [
            {
              "type": "presentation",
              "id": "emerald:truck-ride"
            },
            {
              "type": "sequence",
              "commands": [
                {
                  "type": "wait",
                  "ms": 1500
                },
                {
                  "type": "sound",
                  "cue": "emerald-audio:se_truck_move"
                },
                {
                  "type": "wait",
                  "ms": 7500
                }
              ]
            }
          ]
        },
        {
          "type": "sound",
          "cue": "emerald-audio:se_truck_stop"
        },
        {
          "type": "presentation",
          "id": "emerald:truck-stop"
        },
        {
          "type": "wait",
          "ms": 1500
        },
        {
          "type": "sound",
          "cue": "emerald-audio:se_truck_unload"
        },
        {
          "type": "wait",
          "ms": 2000
        },
        {
          "type": "worldPatch",
          "operations": [
            {
              "kind": "tile",
              "map": "InsideOfTruck",
              "x": 4,
              "y": 1,
              "appearance": 520,
              "scope": "permanent"
            },
            {
              "kind": "tile",
              "map": "InsideOfTruck",
              "x": 4,
              "y": 2,
              "appearance": 528,
              "scope": "permanent"
            },
            {
              "kind": "tile",
              "map": "InsideOfTruck",
              "x": 4,
              "y": 3,
              "appearance": 536,
              "scope": "permanent"
            }
          ]
        },
        {
          "type": "sound",
          "cue": "emerald-audio:se_truck_door"
        },
        {
          "type": "flag",
          "key": "truckArrived",
          "value": true
        }
      ]
    },
    "truck.exit": {
      "commands": [
        {
          "type": "sound",
          "cue": "emerald-audio:se_truck_door"
        },
        {
          "type": "flag",
          "key": "truckLeft",
          "value": true
        },
        {
          "type": "if",
          "condition": {
            "compare": {
              "query": {
                "id": "playerGender"
              },
              "op": "eq",
              "value": "female"
            }
          },
          "then": [
            {
              "type": "scene",
              "kind": "door",
              "position": {
                "map": "LittlerootTown",
                "x": 12,
                "y": 10,
                "dir": "down"
              }
            }
          ],
          "else": [
            {
              "type": "scene",
              "kind": "door",
              "position": {
                "map": "LittlerootTown",
                "x": 3,
                "y": 10,
                "dir": "down"
              }
            }
          ]
        }
      ]
    }
  },
  "entries": {
    "box.read": {
      "trigger": "interact",
      "selector": {
        "map": "InsideOfTruck",
        "script": "InsideOfTruck_EventScript_MovingBox",
        "kind": "sign"
      },
      "script": "box.read"
    },
    "truck.arrival": {
      "trigger": "mapEnter",
      "priority": 20,
      "selector": {
        "map": "InsideOfTruck"
      },
      "requires": {
        "not": {
          "flag": "truckArrived",
          "equals": true
        }
      },
      "script": "truck.arrival"
    },
    "truck.exit": {
      "trigger": "step",
      "priority": 20,
      "where": {
        "map": "InsideOfTruck",
        "x": 4,
        "y": 1,
        "width": 1,
        "height": 3
      },
      "requires": {
        "all": [
          {
            "flag": "truckArrived",
            "equals": true
          },
          {
            "not": {
              "flag": "truckLeft",
              "equals": true
            }
          }
        ]
      },
      "script": "truck.exit"
    }
  },
  "sources": [
    {
      "label": "InsideOfTruck_EventScript_SetIntroFlagsMale",
      "map": "InsideOfTruck",
      "status": "original-verified",
      "note": "coord_event 只设置动态目的地，实际离开位于门列 (4,1..3)；男主落在 (3,10)，女主落在 (12,10)。"
    },
    {
      "label": "ExecuteTruckSequence",
      "map": "InsideOfTruck",
      "status": "original-verified",
      "note": "field_special_scene.c 的90/150/300帧阶段、停车6帧采样19项水平表及90/120帧等待；纯field/objects通道处理镜头与纸箱，worldPatch仅改门格外观。渐亮使用网页alpha对应原作调色板淡入，不声称硬件逐像素等价。"
    },
    {
      "label": "InsideOfTruck_EventScript_MovingBox",
      "map": "InsideOfTruck",
      "status": "original-verified",
      "note": "原文 InsideOfTruck_Text_BoxPrintedWithMonLogo，五处纸箱共用同一脚本。"
    }
  ]
}
