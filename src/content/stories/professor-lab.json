      },
      "requires": {
        "all": [
          {
            "flag": "rescued"
          },
          {
            "reward": "rival.prize"
          },
          {
            "not": {
              "flag": "pokedex"
            }
          }
        ]
      },
      "script": "give-dex"
    }
  },
  "sources": [
    {
      "label": "LittlerootTown_ProfessorBirchsLab_EventScript_Aide",
      "map": "LittlerootTown_ProfessorBirchsLab",
      "status": "original-verified",
      "note": "助手首次/再次/领取初始宝可梦三个分支；博士救援前不在研究所，助手不提供培育业务。"
    },
    {
      "label": "LittlerootTown_ProfessorBirchsLab_EventScript_GivePokedexEvent",
      "status": "original-verified",
      "note": "入图玩家上移七步；图鉴与精灵球分开发放，满包只影响球；对手向下走一格面左。"
    }
  ],
  "projections": [
