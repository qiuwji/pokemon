{
  "version": 1,
  "plugins": [
    {
      "id": "facility-content",
      "module": "./facility-content/index.js",
      "export": "createFacilityContent",
      "enabled": false,
      "arguments": ["json:./facility-content/content.json"]
    },
    {
      "id": "ai-control",
      "module": "./ai-control/index.js",
      "export": "aiControl",
      "enabled": true
    },
    {
      "id": "test-harness",
      "module": "./test-harness.js",
      "export": "createTestHarness",
      "enabled": false,
      "environment": "test",
      "flag": "test-harness",
      "arguments": [
        "content:maps.LittlerootTown_ProfessorBirchsLab"
      ]
    },
    {
      "id": "emerald-audio",
      "module": "./emerald-audio.js",
      "export": "audioPlugin",
      "enabled": true
    }
  ]
}
