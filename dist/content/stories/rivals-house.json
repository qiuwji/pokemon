{
  "id": "emerald:rivals-house",
  "version": 1,
  "dialogues": {
    "neighbor-mom": {
      "name": "邻居的妈妈",
      "bindings": {
        "who": {
          "query": {
            "id": "playerName"
          }
        }
      },
      "lines": [
        "你就是刚搬来的{{who}}吧！我是小田卷博士的妻子。",
        "博士在野外工作，我的孩子就在楼上。快去打个招呼吧！"
      ]
    },
    "may": {
      "name": "小遥",
      "bindings": {
        "who": {
          "query": {
            "id": "playerName"
          }
        }
      },
      "lines": [
        "咦？你……你是谁？",
        "啊，你就是{{who}}！今天刚搬来吧？我是小遥，很高兴认识你！",
        "我的梦想是和全世界的宝可梦成为朋友。爸爸小田卷博士跟我提过你。",
        "希望我们也能成为朋友！……才刚认识就说这些，有点害羞呢。",
        "哎呀，我忘了！还要去帮爸爸捕捉野生宝可梦呢。待会儿见！"
      ]
    },
    "brendan": {
      "name": "小悠",
      "bindings": {
        "who": {
          "query": {
            "id": "playerName"
          }
        }
      },
      "lines": [
        "喂！你是谁？",
        "你就是搬到隔壁的{{who}}吧？原来是个女孩子！",
        "爸爸说邻居是道馆馆主的孩子，我还以为会是男孩呢。",
        "我叫小悠。你好，新邻居！",
        "咦，你还没有宝可梦吗？我得去帮爸爸研究野生宝可梦了。以后见！"
      ]
    },
    "rival-later": {
      "name": "邻居",
      "bindings": {
        "who": {
          "query": {
            "id": "playerName"
          }
        }
      },
      "lines": [
        "宝可梦恢复完毕！道具也准备好了……爸爸还在野外呢。"
      ]
    },
    "go-neighbor": {
      "name": "",
      "bindings": {
        "who": {
          "query": {
            "id": "playerName"
          }
        }
      },
      "lines": [
        "先去隔壁向小田卷博士的家人打个招呼吧。"
      ]
    }
  },
