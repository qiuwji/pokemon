{
  "id": "emerald:oldale",
  "version": 1,
  "dialogues": {
    "welcome": {
      "name": "商店员工",
      "lines": [
        "你好！我在友好商店工作。",
        "可以请你跟我来一下吗？"
      ]
    },
    "full": {
      "name": "商店员工",
      "lines": [
        "背包里已经放不下了。腾出空间后再来领取伤药吧。"
      ]
    },
    "received": {
      "name": "商店员工",
      "lines": [
        "获得了 1 瓶伤药！"
      ]
    },
    "greeting": {
      "name": "商店员工",
      "lines": [
        "伤药随时都能使用。有些时候，它比宝可梦中心还方便呢。"
      ]
    },
    "mart": {
      "name": "商店员工",
      "lines": [
        "这里就是友好商店，认准蓝色的屋顶就行。",
        "我们出售各种道具，包括用来捕捉宝可梦的精灵球。",
        "这份宣传赠品就送给你吧。"
      ]
    },
    "footprints-before": {
      "name": "男子",
      "lines": [
        "我刚发现了一只稀有宝可梦的脚印！",
        "请等我把它画下来，好吗？"
      ]
    },
    "footprints-after": {
      "name": "男子",
      "lines": [
        "我终于画下了那只稀有宝可梦的脚印。",
        "不过，原来那些只是我自己的脚印……"
      ]
    },
    "blocked": {
      "name": "男子",
      "lines": [
        "啊！等等！请不要走进这里！",
        "我刚发现了一只稀有宝可梦的脚印。请等我画完，好吗？"
      ]
    }
  },
