  "dialogues": {
    "you-saved-birch": {
      "name": "邻居家的小孩",
      "lines": [
        "你救下了小田卷博士！",
        "太好了！"
      ]
    },
    "good-luck": {
      "name": "邻居家的小孩",
      "lines": [
        "你要去捕捉宝可梦吗？",
        "祝你好运！"
      ]
    },
    "no-pokemon": {
      "name": "小女孩",
      "lines": [
        "这个、这个、这个！",
        "要是跑到外面草丛里，野生宝可梦就会跳出来！"
      ]
    },
    "dangerous": {
      "name": "小女孩",
      "lines": [
        "没有自己的宝可梦的话，会很危险的。"
      ]
    },
    "go-save-birch": {
      "name": "小女孩",
      "lines": [
        "你好！外面有好吓人的宝可梦！我都听见它们的叫声了！",
        "我想去看看发生了什么，可是我没有宝可梦……",
        "能拜托你去看看吗？"
      ]
    }
  },
