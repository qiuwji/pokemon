    "pc-own": {
      "commands": [
        {
          "type": "dialog",
          "dialogue": "pc-boot"
        },
        {
          "type": "choice",
          "name": "电脑",
          "prompt": "要做什么？",
          "options": [
            {
              "id": "withdraw",
              "label": "取出伤药",
              "commands": [
                {
                  "type": "reward",
                  "id": "emerald:bedroom-pc.potion",
                  "items": {
                    "potion": 1
                  }
                },
                {
                  "type": "dialog",
                  "dialogue": "pc-potion"
                }
              ],
              "visibleWhen": {
                "not": {
                  "reward": "emerald:bedroom-pc.potion"
                }
              },
              "enabledWhen": {
                "compare": {
                  "query": {
                    "id": "itemSpace",
                    "input": {
                      "item": "potion",
                      "count": 1
                    }
                  },
                  "op": "eq",
                  "value": true
                }
              },
              "disabledReason": "背包里放不下伤药。"
            },
            {
              "id": "items",
              "label": "查看道具",
              "commands": [
                {
                  "type": "dialog",
                  "dialogue": "pc-empty"
                }
              ]
            },
            {
              "id": "exit",
              "label": "退出",
              "commands": []
            }
          ]
        }
      ]
    },
