{
  "id": "emerald:players-house",
  "version": 1,
  "dialogues": {
    "welcome": {
      "name": "妈妈",
      "bindings": {
        "who": {
          "query": {
            "id": "playerName"
          }
        }
      },
      "lines": [
        "屋里也不错吧，{{who}}？"
      ]
    },
    "set-clock": {
      "name": "妈妈",
      "bindings": {
        "who": {
          "query": {
            "id": "playerName"
          }
        }
      },
      "lines": [
        "搬运公司的宝可梦搬完东西，还帮忙打扫了呢。真方便呀！",
        "{{who}}，你的房间在楼上。爸爸买了一只新时钟，记得去调好时间哦！"
      ]
    },
    "go-up": {
      "name": "妈妈",
      "bindings": {
        "who": {
          "query": {
            "id": "playerName"
          }
        }
      },
      "lines": [
        "还没有调好时钟呢，{{who}}。先去看看自己的房间吧！"
      ]
    },
    "room": {
      "name": "妈妈",
      "bindings": {
        "who": {
          "query": {
            "id": "playerName"
          }
        }
      },
      "lines": [
        "{{who}}，你喜欢自己的新房间吗？",
        "很好！东西都收拾得整整齐齐了。楼下也搬完了。",
        "宝可梦搬家服务真方便！别忘了看看桌上的东西有没有都在哦。"
      ]
    },
    "stopped": {
      "name": "时钟",
      "bindings": {
        "who": {
          "query": {
            "id": "playerName"
          }
        }
      },
      "lines": [
        "钟停了呢……还是调好时间，让它开始走吧！"
      ]
    },
    "tv-call": {
      "name": "妈妈",
      "bindings": {
        "who": {
          "query": {
            "id": "playerName"
          }
        }
      },
      "lines": [
        "{{who}}，快过来！快过来！"
      ]
    },
    "tv-dad": {
      "name": "妈妈",
      "bindings": {
        "who": {
          "query": {
            "id": "playerName"
          }
        }
      },
      "lines": [
        "电视在报道橙华道馆！说不定能看到爸爸呢！"
      ]
    },
    "tv-report": {
      "name": "电视",
      "bindings": {
        "who": {
          "query": {
            "id": "playerName"
          }
        }
      },
      "lines": [
        "这里是橙华道馆，我们刚才为大家带来了现场报道。"
      ]
    },
    "tv-over": {
      "name": "妈妈",
      "bindings": {
        "who": {
          "query": {
            "id": "playerName"
          }
        }
      },
      "lines": [
        "啊，已经结束了！我们错过爸爸了呢。",
        "小田卷博士住在隔壁。他是爸爸的朋友。",
        "{{who}}，去隔壁打个招呼、认识一下他的孩子吧！"
      ]
    },
    "mom-talk": {
      "name": "妈妈",
      "bindings": {
        "who": {
          "query": {
            "id": "playerName"
          }
        }
      },
      "lines": [
        "你见到小田卷博士了吗？研究所就在镇子的南边。"
      ]
    },
    "mom-heal": {
      "name": "妈妈",
      "bindings": {
        "who": {
          "query": {
            "id": "playerName"
          }
        }
      },
      "lines": [
        "冒险一定很累吧？先休息一会儿。"
      ]
    },
    "mom-after": {
      "name": "妈妈",
      "bindings": {
        "who": {
          "query": {
            "id": "playerName"
          }
        }
      },
      "lines": [
        "你和宝可梦都精神起来了！路上小心哦。"
      ]
    },
    "vigoroth.0": {
      "name": "过动猿",
      "lines": [
        "咕哦！"
      ]
    },
    "vigoroth.1": {
      "name": "过动猿",
      "lines": [
        "呜呜！"
      ]
    }
  },
